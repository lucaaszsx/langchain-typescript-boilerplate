# Timezone
TZ=America/Sao_Paulo

# Groq API key
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Ollama Embeddings
OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text-v2-moe
OLLAMA_EMBEDDINGS_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDINGS_DIMENSION=768

# QDrant Client
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=assistant